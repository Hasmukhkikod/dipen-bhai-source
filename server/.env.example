# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Long random string used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used only once by `npm run seed` to create the first admin login.
# Change the password after your first login via the admin panel.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=dipen123

# Comma-separated list of origins allowed to call this API in production
# (your deployed site's URL). Not needed in dev (Vite's proxy same-origins it).
CORS_ORIGIN=
